# Anthropic API anahtarı (https://console.anthropic.com/). YALNIZCA panel özeti
# (summary_api) için kullanılır. CV ve mektup Claude Code agent'larıyla, abonelik girişiyle
# üretilir; agent_runner bu anahtarı claude -p'nin ortamından bilerek siler.
ANTHROPIC_API_KEY=

# CV agent'larının (cv-writer / cv-reviewer) modeli ve effort'u: claude -p --model / --effort.
# effort: low / medium / high / xhigh / max. Ölçümler (Sonnet 5): medium en iyi denge;
# önemli bir ilan için tek CV'yi CV_EFFORT=high ile yeniden üret (scripts/regenerate.py).
# (Eski CLAUDE_MODEL / CLAUDE_EFFORT adları kullanılmıyor: CLAUDE_EFFORT, Claude Code'un
# kendi değişkeniyle çakışıp buradaki değeri sessizce eziyordu.)
CV_MODEL=claude-sonnet-5
CV_EFFORT=medium
# Mektup agent'ının (cover-letter-writer) modeli; düşük effort ile çalışır.
COVER_LETTER_MODEL=claude-sonnet-5
# LinkedIn İlan Özeti API'sinin modeli (eklenti). Kısa özetler için hızlı ve ucuz Haiku.
SUMMARY_MODEL=claude-haiku-4-5
# claude CLI'nin yolu. Boşsa PATH'te, sonra ~/.local/bin/claude'da aranır.
CLAUDE_BIN=

# İkinci uzman QA geçişi (cv-reviewer agent'ı): kapalı. Doğrula/düzelt kontrol listesi
# zaten tek üretim geçişinin içinde (ats-cv-kurallari, ADIM 12). on / off
CV_REVIEW=off

# CV üretiminin ana anahtarı. on / off (varsayılan on).
#   on  = B="Üretilecek" satırlara tam CV + sheet bilgisi.
#   off = satırlar yine işlenir ve sayfa bilgisi (şehir, şirket, başlık, çalışma tipi…)
#         sheet'e yazılır, ama CV ÜRETİLMEZ. Bu satırların CV No sütununa (N) "Yok" yazılır;
#         anahtarı yeniden açınca geriye dönük üretilmezler. Belirli bir satır için sonradan
#         CV istersen N'deki "Yok"u elle sil.
CV_GENERATION=on

# CV'nin .docx şablonu (templates/ altında). Boşsa cv_template.docx: ATS düzeltmeli tasarım
# (A4, tablosuz eğitim, alt çizgisiz başlıklar, görünür URL'ler, ASCII tarihler).
# Eski tasarıma dönmek için: CV_TEMPLATE=cv_template_eski.docx — sonra poller'ı (start.sh)
# yeniden başlat. Eski şablonla PDF kontrolü alt çizgi / en-dash / URL uyarıları vermeye devam
# eder; bu doğru: o tasarımın ATS riskleri bunlar.
# Yeni tasarımla üretilmiş bir CV'yi eski tasarımda yeniden basmak (model çağrısı yok):
#   CV_TEMPLATE=cv_template_eski.docx ./.venv/bin/python scripts/rebuild_pdf.py --from 560 --to 560
CV_TEMPLATE=

# Drive'daki .xlsx dosyasının kimliği (Drive linkindeki uzun id).
SPREADSHEET_ID=

# İlan satırlarını tutan sekme adı (Türkçe Google'da varsayılan "Sayfa1")
SHEET_NAME=Sayfa1

# Poller'ın sheet'i yoklama aralığı (saniye). Yoklama model çağırmaz; B="Üretilecek" bir
# satır görünce CV agent'ı başlatılır.
POLL_INTERVAL=20

# Çıktı klasörleri. Boş bırakılırsa proje içindeki outputs/ kullanılır (önerilen, gitignore'da):
#   outputs/cv/markdown, outputs/cv/pdf, outputs/cv/analysis, outputs/job_descriptions,
#   outputs/cover_letters
# OUTPUT_DIR=
# ANALYSIS_DIR=
# JOB_DESCRIPTION_DIR=
# COVER_LETTER_DIR=

# Google Doc CV'lerin oluşturulacağı Drive klasörü (SENİN hesabında).
RESUMES_FOLDER_NAME=Resumes Based on Jobs
# İsteğe bağlı: ad aramasını atlamak için klasör kimliğini (Drive URL'sinden) doğrudan ver.
RESUMES_FOLDER_ID=

# --- Huntr entegrasyonu (İSTEĞE BAĞLI, varsayılan kapalı) ---
# Yeni ilanlar normalde panelin "Ekle" butonundan gelir; bunu BOŞ bırak.
# Kaydedilen ilanları sheet'e otomatik aktarmak için Huntr board URL'ni yaz.
HUNTR_BOARD_URL=
# Huntr board'unun ne sıklıkla (saniye) kontrol edileceği.
HUNTR_POLL_INTERVAL=30
