{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__cv-tools",
      "Read",
      "Glob",
      "Grep",
      "Agent",
      "Write(outputs/**)",
      "Edit(outputs/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(credentials/**)"
    ]
  },
  "enabledMcpjsonServers": ["cv-tools"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/bin/python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_secrets.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.venv/bin/python \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check_cv_output.py"
          }
        ]
      }
    ]
  }
}
